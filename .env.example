# Copy to .env for local overrides. Defaults (no .env at all) = 4 SQLite shards + in-memory bus,
# which needs zero external services.

# One URL per shard, comma separated. Order matters: shard index = position in this list,
# and changing the number of shards requires a data migration (see DECISIONS.md #1).
# SHARD_URLS=postgresql+psycopg2://httpe:httpe@localhost:5432/shard_0,postgresql+psycopg2://httpe:httpe@localhost:5432/shard_1,postgresql+psycopg2://httpe:httpe@localhost:5432/shard_2,postgresql+psycopg2://httpe:httpe@localhost:5432/shard_3

# memory | kafka
EVENT_BUS_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_TRANSACTIONS=payments.transactions
KAFKA_CONSUMER_GROUP=settlement-workers

# true = API process also runs relay + settlement (memory bus only). false when using a separate worker.
EMBED_WORKER=true
OUTBOX_RELAY_INTERVAL_SECONDS=0.2

BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_SECONDS=30
